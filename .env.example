# Copy to .env and fill in. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Default tenant (one graph per org: org_<tenant>)
DEFAULT_TENANT=astroshop

# ---------------------------------------------------------------------------
# LLM fallback chain. Providers are tried in this order; within a provider,
# its models are tried in order. A provider with an empty key is skipped;
# Ollama (local, no key) is skipped while it is not running.
# You need at least ONE key, or a running Ollama.
# Check with: python -m blastradius.llm status   |   python -m blastradius.llm ping
# ---------------------------------------------------------------------------
LLM_PROVIDER_ORDER=groq,gemini,openrouter,openai,anthropic,custom,ollama

# 1. Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_RPM=30

# 2. Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash
# GEMINI_RPM=10

# 3. OpenRouter (free models end with :free) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openai/gpt-oss-20b:free
# OPENROUTER_RPM=20

# 4. OpenAI (paid) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5-mini
# OPENAI_RPM=60

# 5. Anthropic Claude (paid), via the official Anthropic SDK - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5          (e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost)
# ANTHROPIC_RPM=50

# 6. Custom: any OpenAI-compatible API (Cerebras, Mistral, Together, DeepSeek, ...)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_MODELS=
# CUSTOM_RPM=30

# 7. Ollama (local, last resort, no key) - https://ollama.com/download  then: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODELS=qwen3:8b

# ---------------------------------------------------------------------------
# Optional: let the investigator open real GitHub issues (otherwise recorded as a dry run)
# Fine-grained token with "Issues: Read and write" on one repo only.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=

# ---------------------------------------------------------------------------
# Optional: post incidents to chat when identified and when resolved. Webhook URLs are secrets.
# Slack: api.slack.com/apps -> Create New App -> Incoming Webhooks -> Add New Webhook to Workspace
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
