# Copy to .env and fill in. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Default tenant (one graph per org: org_<tenant>)
DEFAULT_TENANT=astroshop

# LLM providers (fallback order is set in the LLM gateway; leave a key empty to skip that provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
